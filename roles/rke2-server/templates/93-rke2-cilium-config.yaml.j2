---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    cluster:
      name: {{ rke2_server.cilium.cluster.name }}
      id: {{ rke2_server.cilium.cluster.id }}
    routingMode: {{ rke2_server.cilium.routingMode }}
{% if rke2_server.cilium.routingMode == "native" %}
    ipv4NativeRoutingCIDR: {{ rke2_server.cilium.ipv4NativeRoutingCIDR }}
{% endif %}
{% if rke2_server.cilium.routingMode == "tunnel" %}
    tunnelProtocol: {{ rke2_server.cilium.tunnelProtocol }}
    tunnelPort: {{ rke2_server.cilium.tunnelPort }}
    MTU: {{ rke2_server.cilium.MTU }}
{% endif %}
    kubeProxyReplacement: {{ rke2_server.cilium.kubeProxyReplacement | string | lower }}
    k8sServiceHost: {{ rke2_server.tls_san[0] }}
    k8sServicePort: 6443
    resources:
      limits:
        cpu: {{ rke2_server.cilium.resources.limits.cpu }}
        memory: {{ rke2_server.cilium.resources.limits.memory }}
      requests:
        cpu: {{ rke2_server.cilium.resources.requests.cpu }}
        memory: {{ rke2_server.cilium.resources.requests.memory }}
    operator:
       replicas: {{ rke2_server.cilium.operator.replicas }}
       resources:
         limits:
           cpu: {{ rke2_server.cilium.operator.resources.limits.cpu }}
           memory: {{ rke2_server.cilium.operator.resources.limits.memory }}
         requests:
           cpu: {{ rke2_server.cilium.operator.resources.requests.cpu }}
           memory: {{ rke2_server.cilium.operator.resources.requests.memory }}

    ipv4:
      enabled: {{ rke2_server.cilium.ipv4.enabled | string | lower }}
    ipv6:
      enabled: {{ rke2_server.cilium.ipv6.enabled | string | lower }}
    ipam:
      mode: {{ rke2_server.cilium.ipam.mode }}
      ciliumNodeUpdateRate: {{ rke2_server.cilium.ipam.ciliumNodeUpdateRate }}
      operator:
        clusterPoolIPv4PodCIDRList: {{ rke2_server.cilium.ipam.operator.clusterPoolIPv4PodCIDRList }}
        clusterPoolIPv4MaskSize: {{ rke2_server.cilium.ipam.operator.clusterPoolIPv4MaskSize }}
        clusterPoolIPv6PodCIDRList: {{ rke2_server.cilium.ipam.operator.clusterPoolIPv6PodCIDRList }}
        clusterPoolIPv6MaskSize: {{ rke2_server.cilium.ipam.operator.clusterPoolIPv6MaskSize }}
    
    encryption:
      enabled: {{ rke2_server.cilium.encryption.enabled | string | lower }}
      type: {{ rke2_server.cilium.encryption.type }}
      nodeEncryption: {{ rke2_server.cilium.encryption.nodeEncryption | string | lower }}
    l7Proxy: {{ rke2_server.cilium.l7Proxy | string | lower }}
    dnsProxy:
      enableTransparentMode: {{ rke2_server.cilium.dnsProxy.enableTransparentMode | string | lower }}

    gatewayAPI:
      enabled: {{ rke2_server.cilium.gatewayAPI.enabled | string | lower }}
      externalTrafficPolicy: {{ rke2_server.cilium.gatewayAPI.externalTrafficPolicy }}
      gatewayClass:
        create: '{{ rke2_server.cilium.gatewayAPI.gatewayClass.create }}'
      hostNetwork:
        enabled: {{ rke2_server.cilium.gatewayAPI.hostNetwork.enabled | string | lower }}
        nodes:
          matchLabels:
{% for key, value in rke2_server.cilium.gatewayAPI.hostNetwork.nodes.matchLabels.items() %}
            {{ key }}: {{ value }}
{% endfor %}
    envoy:
      enabled: {{ rke2_server.cilium.envoy.enabled | string | lower }}
    enableIPv4Masquerade: {{ rke2_server.cilium.enableIPv4Masquerade | string | lower }}
    enableIPv6Masquerade: {{ rke2_server.cilium.enableIPv6Masquerade | string | lower }}
    bpf:
      masquerade: {{ rke2_server.cilium.bpf.masquerade | string | lower }}
      hostLegacyRouting: {{ rke2_server.cilium.bpf.hostLegacyRouting | string | lower }}
      preallocateMaps: {{ rke2_server.cilium.bpf.preallocateMaps | string | lower }}
      distributedLRU:
        enabled: {{ rke2_server.cilium.bpf.distributedLRU.enabled | string | lower }}
      ctTcpMax: {{ rke2_server.cilium.bpf.ctTcpMax }}
      ctAnyMax: {{ rke2_server.cilium.bpf.ctAnyMax }}
      natMax: {{ rke2_server.cilium.bpf.natMax }}
      lbMapMax: {{ rke2_server.cilium.bpf.lbMapMax }}
